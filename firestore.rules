rules_version = '2';

// ============================================================================
// Firestore Security Rules — Car Sale Mini Project
//
// Admin membership is driven by the `admins` collection: a user is an admin
// iff a document named by their auth UID exists at admins/<uid>. Add or
// remove admins from the Firebase Console (or the List Admin page in the
// app) — no rule edits needed.
//
// IMPORTANT — one-time migration: BEFORE publishing these rules, create the
// `admins` collection and add a document for each current admin UID
// (Firebase Console -> Firestore Database -> admins -> Add document, id =
// the UID). Otherwise every admin locks themselves out the moment these
// rules go live.
//
// Apply these rules in the Firebase Console:
//   Firebase Console -> Firestore Database -> Rules -> paste -> Publish
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // admins: who is allowed to manage the shop — admin manages admins.
    // create/update must keep doc.uid equal to the doc id (keeps the
    // collection honest); delete may never target your own doc, so a
    // stray delete can't lock the last admin out server-side.
    match /admins/{uid} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.uid == uid;
      allow delete: if isAdmin()
        && request.auth.uid != uid;
    }

    // products: public catalog — anyone can read, only admin can write
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // profiles: contains user PII (name, email, phone, address)
    // - a user can read only their own profile
    // - a user can create only their own profile
    // - only admin can read all, update, or delete
    match /profiles/{profileId} {
      allow get, list: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // invoices (transactions)
    // - a user can read only their own invoices
    // - a user can create only their own invoice (checkout)
    // - only admin can read all or delete
    match /invoices/{invoiceId} {
      allow get, list: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
