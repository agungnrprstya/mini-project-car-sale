rules_version = '2';

// ============================================================================
// Firestore Security Rules — Car Sale Mini Project
//
// 🚨 IMPORTANT: Before deploying to production, update the ADMIN_UIDs below
// with the actual Firebase Auth UIDs matching REACT_APP_ADMIN_ID_1 and
// REACT_APP_ADMIN_ID_2 in your .env.
//
// These placeholder values will BLOCK all admin write operations.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.uid in ['REPLACE_WITH_ACTUAL_ADMIN_UID_1', 'REPLACE_WITH_ACTUAL_ADMIN_UID_2'];
    }

    // products: public catalog — anyone can read, only admin can write
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // profiles: contains user PII (name, email, phone, address)
    // - a user can read only their own profile
    // - a user can create only their own profile
    // - only admin can read all, update, or delete
    match /profiles/{profileId} {
      allow get, list: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // invoices (transactions)
    // - a user can read only their own invoices
    // - a user can create only their own invoice (checkout)
    // - only admin can read all or delete
    match /invoices/{invoiceId} {
      allow get, list: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
